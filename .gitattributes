# 排除 artifacts 和 builds 目录，不包含在 GitHub 自动生成的源码压缩包中
artifacts/ export-ignore
builds/ export-ignore

# cmd/ 下均为 fnOS 生命周期 shell 脚本，强制 LF：Windows 检出（core.autocrlf=true）会转成
# CRLF，行尾 \r 会让脚本在 fnOS 上执行报错，且 build.py 直接从工作区复制打包，CRLF 会进 fpk
cmd/* text eol=lf

# manifest 与 README.md 同样强制 LF。
# build-and-release.yml 用 `grep "^version = " manifest | cut -d' ' -f3` 取版本号，
# 若检出为 CRLF，取到的就是 `4.1.3.4\r`（\r 不是空白符，cut 不会去掉），
# 这个值会进 $GITHUB_ENV 并拼出带 CR 的包名 transmission-4.1.3.4<CR>-amd64.fpk。
# 在仓库层统一行尾，比在每个消费点各自 tr -d '\r' 更可靠。
manifest text eol=lf
README.md text eol=lf
