#!/bin/bash
# cmd/upgrade_callback - Transmission升级回调脚本
# 功能：升级后恢复数据、设置权限、验证配置、启动服务

APP_NAME="transmission-daemon"

# 写入错误日志并退出
ERROR_LOG="${TRIM_TEMP_LOGFILE:-/tmp/${APP_NAME}_error.log}"
error_exit() {
    local message="$1"
    local exit_code="${2:-1}"
    echo "$message" > "$ERROR_LOG"
    exit $exit_code
}
BIN_DIR="${TRIM_APPDEST}/bin"
LIB_DIR="${TRIM_APPDEST}/lib"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_DIR="${DATA_DIR}/settings.json"
CONFIG_FILE="${CONFIG_DIR}"
PID_FILE="${TRIM_PKGTMP}/${APP_NAME}.pid"

# 备份在shares目录（解析 TRIM_DATA_SHARE_PATHS 多路径，取第一个可用）
SHARE_DIR=""
if [ -n "$TRIM_DATA_SHARE_PATHS" ]; then
    IFS=':' read -ra _share_parts <<< "$TRIM_DATA_SHARE_PATHS"
    for _p in "${_share_parts[@]}"; do
        _p="${_p%/}"
        if [ -n "$_p" ] && [ "$_p" != "/" ] && [ -d "$_p" ]; then
            SHARE_DIR="$_p"
            break
        fi
    done
fi
if [ -z "$SHARE_DIR" ]; then
    SHARE_DIR="/vol1/@appshare/transmission"
fi
BACKUP_DIR="${SHARE_DIR}/.data_backup"
# 优先从备份信息文件定位（兼容共享路径解析差异，防止备份存在却找不到）
if [ -f "${SHARE_DIR}/.backup_info" ]; then
    _info_backup=$(grep '^BACKUP_DIR=' "${SHARE_DIR}/.backup_info" 2>/dev/null | cut -d= -f2-)
    if [ -n "$_info_backup" ] && [ -d "$_info_backup" ]; then
        BACKUP_DIR="$_info_backup"
    fi
fi

# 保护：备份目录绝不能位于数据目录内部（防止误删/误恢复用户数据）
case "$BACKUP_DIR/" in
    "$DATA_DIR/"*)
        SHARE_DIR="/vol1/@appshare/transmission"
        BACKUP_DIR="${SHARE_DIR}/.data_backup"
        ;;
esac

echo "=================================="
echo "Transmission 升级完成"
echo "=================================="
echo ""

# 设置可执行权限
echo "[1/3] 设置可执行权限..."
if ! chmod +x "$BIN_DIR/transmission-daemon" 2>/dev/null; then
    error_exit "错误：设置可执行权限失败，升级完成但服务可能无法启动"
fi

# 设置库文件权限
if [ -d "$LIB_DIR" ]; then
    chmod 755 "$LIB_DIR" 2>/dev/null || true
    chmod 755 "$LIB_DIR"/*.so* 2>/dev/null || true
fi

# 验证二进制文件
echo "[2/3] 验证新安装..."
if [ -x "$BIN_DIR/transmission-daemon" ]; then
    echo "找到 transmission-daemon 并可执行"
    # 需要设置 LD_LIBRARY_PATH 否则找不到 libminiupnpc.so.17
    VERSION=$(LD_LIBRARY_PATH="${LIB_DIR}" "$BIN_DIR/transmission-daemon" --version 2>&1 | head -1)
    echo "版本: $VERSION"
else
    error_exit "错误：transmission-daemon 未找到或不可执行"
fi

# 恢复数据（如果存在备份）
echo ""
echo "[3/3] 恢复数据..."

BACKUP_EXISTS=false
if [ -d "$BACKUP_DIR" ] && [ -n "$(ls -A "$BACKUP_DIR" 2>/dev/null)" ]; then
    BACKUP_EXISTS=true
fi

if [ "$BACKUP_EXISTS" = true ]; then
    # 有备份：合并恢复，绝不先删除现有数据（即使恢复失败，原数据也不会丢失）
    echo "从备份恢复数据（合并不删除现有文件）..."
    mkdir -p "$DATA_DIR"
    if ! cp -a "$BACKUP_DIR"/. "$DATA_DIR"/ 2>/dev/null; then
        echo "错误：从备份恢复数据失败，备份已保留在 $BACKUP_DIR，请勿删除！" > "$ERROR_LOG"
        exit 1
    fi
    echo "数据恢复成功"

    # 仅在关键数据完整恢复后才清理备份，避免恢复不完整导致数据不可恢复
    CLEANUP_OK=true
    if [ ! -f "$DATA_DIR/settings.json" ]; then
        CLEANUP_OK=false
    fi
    if [ -d "${BACKUP_DIR}/torrents" ] && [ -n "$(ls -A "${BACKUP_DIR}/torrents" 2>/dev/null)" ]; then
        if [ ! -d "$DATA_DIR/torrents" ] || [ -z "$(ls -A "$DATA_DIR/torrents" 2>/dev/null)" ]; then
            CLEANUP_OK=false
        fi
    fi
    if [ -d "${BACKUP_DIR}/resume" ] && [ -n "$(ls -A "${BACKUP_DIR}/resume" 2>/dev/null)" ]; then
        if [ ! -d "$DATA_DIR/resume" ] || [ -z "$(ls -A "$DATA_DIR/resume" 2>/dev/null)" ]; then
            CLEANUP_OK=false
        fi
    fi
    if [ "$CLEANUP_OK" = true ]; then
        rm -rf "$BACKUP_DIR" 2>/dev/null || true
        echo "已清理shares中的备份"
    else
        echo "警告：恢复校验未通过（settings.json/torrents/resume 不完整），备份已保留在 $BACKUP_DIR"
    fi

    # 修复数据目录权限（确保可写）
    chown -R package:package "$DATA_DIR" 2>/dev/null || true
    chmod 755 "$DATA_DIR" 2>/dev/null || true
    find "$DATA_DIR" -type d -exec chmod 755 {} \; 2>/dev/null || true
    find "$DATA_DIR" -type f -exec chmod 644 {} \; 2>/dev/null || true
    
    # 确保临时目录权限正确
    if [ -n "$TRIM_PKGTMP" ]; then
        chown -R package:package "$TRIM_PKGTMP" 2>/dev/null || true
        chmod 777 "$TRIM_PKGTMP" 2>/dev/null || true
    fi
else
    # 检查是否有真实数据
    CONFIG_EXISTS=false
    if [ -f "$CONFIG_FILE" ]; then
        if [ -d "$DATA_DIR/torrents" ] && [ -n "$(ls -A "$DATA_DIR/torrents" 2>/dev/null)" ]; then
            CONFIG_EXISTS=true
        elif [ -d "$DATA_DIR/resume" ] && [ -n "$(ls -A "$DATA_DIR/resume" 2>/dev/null)" ]; then
            CONFIG_EXISTS=true
        fi
    fi
    
    if [ "$CONFIG_EXISTS" = true ]; then
        echo "发现现有数据，使用当前数据"
        # 修复数据目录权限（确保可写）
        chown -R package:package "$DATA_DIR" 2>/dev/null || true
        chmod 755 "$DATA_DIR" 2>/dev/null || true
        find "$DATA_DIR" -type d -exec chmod 755 {} \; 2>/dev/null || true
        find "$DATA_DIR" -type f -exec chmod 644 {} \; 2>/dev/null || true
    else
        echo "无备份且无现有数据，保持默认配置"
        mkdir -p "$(dirname "$CONFIG_DIR")"
    fi
fi

# 兼容旧版：仅当 rpc 关键配置缺失时补默认，不再覆盖用户已有的 RPC 绑定/认证设置
# （避免升级后用户自定义的 RPC 对外直连 / 认证配置被重置）
if [ -f "$CONFIG_DIR" ]; then
    echo "检查并补全 RPC 配置..."
    python3 - "$CONFIG_DIR" << 'PYEOF'
import json, sys
config_path = sys.argv[1]
try:
    with open(config_path, 'r', encoding='utf-8') as f:
        cfg = json.load(f)
    cfg.setdefault("rpc-authentication-required", False)
    cfg.setdefault("rpc-bind-address", "127.0.0.1")
    with open(config_path, 'w', encoding='utf-8') as f:
        json.dump(cfg, f, indent=4, ensure_ascii=False)
except Exception as e:
    sys.stderr.write("补全 RPC 配置失败 %s: %s\n" % (config_path, e))
    sys.exit(1)
PYEOF
fi

# 启动服务
echo ""
echo "[完成] 启动服务..."

# 查找main脚本
MAIN_SCRIPT=""
for path in "${TRIM_APPDEST}/cmd/main" "${TRIM_PKGETC}/../cmd/main" "/var/apps/transmission/cmd/main"; do
    if [ -x "$path" ]; then
        MAIN_SCRIPT="$path"
        break
    fi
done

if [ -n "$MAIN_SCRIPT" ]; then
    # 同步/修复网关免密凭证：升级后 settings.json 密码通常已是 hash，
    # 若 .rpc_secret 缺失则重建随机内部凭证，避免升级后打开桌面图标弹认证框
    "$MAIN_SCRIPT" write_secret 2>/dev/null || true
    "$MAIN_SCRIPT" start
    EXIT_CODE=$?
else
    error_exit "错误：未找到 main 脚本，启动失败"
fi

if [ $EXIT_CODE -eq 0 ]; then
    echo ""
    echo "=================================="
    echo "Transmission 升级成功完成！"
    echo "=================================="
    echo ""
    echo "网关模式: /app/transmission -> 127.0.0.1"
    exit 0
else
    echo ""
    echo "=================================="
    echo "警告：升级完成但服务启动失败"
    echo "=================================="
    echo "请检查日志: ${TRIM_PKGVAR}/${APP_NAME}.log"
    error_exit "错误：服务启动失败，请检查配置"
fi
