#!/bin/bash
# cmd/install_callback - Transmission安装后置脚本

APP_NAME="transmission-daemon"
BIN_DIR="${TRIM_APPDEST}/bin"
LIB_DIR="${TRIM_APPDEST}/lib"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_DIR="${DATA_DIR}/settings.json"

echo "正在执行 ${APP_NAME} 安装后置脚本..."

# 设置可执行权限
if ! chmod +x "$BIN_DIR/transmission-daemon" 2>/dev/null; then
    echo "错误：无法设置可执行权限" > "$TRIM_TEMP_LOGFILE"
    exit 1
fi

# 设置库文件权限（755 对.so库是推荐的，包含执行权限）
if [ -d "$LIB_DIR" ]; then
    chmod 755 "$LIB_DIR" 2>/dev/null || true
    chmod 755 "$LIB_DIR"/*.so* 2>/dev/null || true
fi

# 获取用户配置（从向导或环境变量）
# 向导变量名: wizard_rpc_username, wizard_rpc_password
RPC_USERNAME="${wizard_rpc_username:-${RPC_USERNAME:-admin}}"
RPC_PASSWORD="${wizard_rpc_password:-${RPC_PASSWORD:-password}}"

# 获取下载目录配置（从向导或环境变量）
SAVE_PATH="${wizard_save_path:-/vol1/@appshare/transmission/downloads/}"

# 网关模式：端口固定内部值
WEBUI_PORT="9090"

echo "正在应用配置..."
echo "用户名: ${RPC_USERNAME}"
echo "下载目录: ${SAVE_PATH}"

# 创建配置目录
mkdir -p "$DATA_DIR"
mkdir -p "$DATA_DIR/torrents"

# 设置目录权限（让 package 用户可写）
chown -R package:package "$DATA_DIR" 2>/dev/null || true
chmod 755 "$DATA_DIR" 2>/dev/null || true
chmod 755 "$DATA_DIR/torrents" 2>/dev/null || true

# 检查配置文件是否已存在（用户卸载时可能保留了配置）
if [ -f "$CONFIG_DIR" ]; then
    echo "检测到已有配置文件，保留其他设置并更新用户名、密码、下载目录..."

    # 使用 sed 更新 JSON 配置文件中的指定字段
    # 更新 download-dir
    sed -i "s|\"download-dir\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"download-dir\": \"${SAVE_PATH}\"|g" "$CONFIG_DIR"

    # 更新 rpc-username
    sed -i "s|\"rpc-username\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"rpc-username\": \"${RPC_USERNAME}\"|g" "$CONFIG_DIR"

    # 更新 rpc-password
    sed -i "s|\"rpc-password\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"rpc-password\": \"${RPC_PASSWORD}\"|g" "$CONFIG_DIR"

    # 网关模式：禁用RPC认证（网关已认证）、绑定127.0.0.1
    sed -i 's|"rpc-authentication-required"[[:space:]]*:[[:space:]]*[^,]*|"rpc-authentication-required": false|g' "$CONFIG_DIR"
    if ! grep -q '"rpc-bind-address"' "$CONFIG_DIR"; then
        sed -i '/"rpc-port"/a\    "rpc-bind-address": "127.0.0.1",' "$CONFIG_DIR"
    else
        sed -i 's|"rpc-bind-address"[[:space:]]*:[[:space:]]*"[^"]*"|"rpc-bind-address": "127.0.0.1"|g' "$CONFIG_DIR"
    fi

    # 确保禁用临时目录
    if grep -q '"incomplete-dir-enabled"' "$CONFIG_DIR"; then
        sed -i 's|"incomplete-dir-enabled"[[:space:]]*:[[:space:]]*[^,]*|"incomplete-dir-enabled": false|g' "$CONFIG_DIR"
    else
        # 如果不存在该字段，在 download-dir 后面添加
        sed -i "s|\"download-dir\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"download-dir\": \"${SAVE_PATH}\",\n    \"incomplete-dir-enabled\": false|g" "$CONFIG_DIR"
    fi

    echo "配置已更新（保留原有其他设置）"
else
    echo "创建新配置文件..."

    # 生成配置文件（使用 cat 配合 EOF 注入变量值）
    cat > "$CONFIG_DIR" << EOF
{
    "download-dir": "${SAVE_PATH}",
    "incomplete-dir-enabled": false,
    "dht-enabled": true,
    "pex-enabled": true,
    "lpd-enabled": true,
    "encryption": 1,
    "peer-limit-global": 200,
    "peer-port": 51413,
    "peer-port-random-on-start": true,
    "rpc-enabled": true,
    "rpc-authentication-required": false,
    "rpc-bind-address": "127.0.0.1",
    "rpc-port": ${WEBUI_PORT},
    "rpc-url": "/transmission/",
    "rpc-host-whitelist-enabled": false,
    "rpc-whitelist-enabled": false,
    "rpc-username": "${RPC_USERNAME}",
    "rpc-password": "${RPC_PASSWORD}",
    "start-added-torrents": true,
    "utp-enabled": true
}
EOF

    echo "新配置文件已创建"
fi

echo ""
echo "=================================="
echo "Transmission 安装完成"
echo "=================================="
echo ""
echo "网关模式: /app/transmission -> 127.0.0.1:${WEBUI_PORT}"
echo ""
echo "用户名: ${RPC_USERNAME}"
echo "下载目录: ${SAVE_PATH}"
echo "数据目录: $DATA_DIR"
echo "配置文件: $CONFIG_DIR"
echo ""

echo "Transmission 安装成功"
exit 0
