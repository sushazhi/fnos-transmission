#!/bin/bash
# cmd/install_callback - Transmission安装后置脚本

APP_NAME="transmission-daemon"
BIN_DIR="${TRIM_APPDEST}/bin"
LIB_DIR="${TRIM_APPDEST}/lib"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_DIR="${DATA_DIR}/settings.json"

echo "正在执行 ${APP_NAME} 安装后置脚本..."

# 设置可执行权限
if ! chmod +x "$BIN_DIR/transmission-daemon" 2>/dev/null; then
    echo "错误：无法设置可执行权限" > "$TRIM_TEMP_LOGFILE"
    exit 1
fi

# WebUI 后端（transmission-manager）可执行权限
chmod +x "$BIN_DIR/transmission-manager" 2>/dev/null || echo "警告：无法设置 transmission-manager 可执行权限"

# 设置库文件权限（755 对.so库是推荐的，包含执行权限）
if [ -d "$LIB_DIR" ]; then
    chmod 755 "$LIB_DIR" 2>/dev/null || true
    chmod 755 "$LIB_DIR"/*.so* 2>/dev/null || true
fi

# 获取用户配置（从向导或环境变量）
# 重装/升级时留空用户名和密码将保留已有配置
RPC_USERNAME="${wizard_rpc_username:-}"
RPC_PASSWORD="${wizard_rpc_password:-}"

# 获取下载目录配置（从向导或环境变量）
SAVE_PATH="${wizard_save_path:-/vol1/@appshare/transmission/downloads/}"

# 网关模式：端口固定内部值
WEBUI_PORT="9090"

echo "正在应用配置..."
echo "下载目录: ${SAVE_PATH}"

# 创建配置目录
mkdir -p "$DATA_DIR"
mkdir -p "$DATA_DIR/torrents"

# 设置目录权限（让 package 用户可写）
chown -R package:package "$DATA_DIR" 2>/dev/null || true
chmod 755 "$DATA_DIR" 2>/dev/null || true
chmod 755 "$DATA_DIR/torrents" 2>/dev/null || true

# 确保临时目录存在且权限正确（防止 @apptemp 权限问题）
if [ -n "$TRIM_PKGTMP" ]; then
    mkdir -p "$TRIM_PKGTMP" 2>/dev/null || true
    chown -R package:package "$TRIM_PKGTMP" 2>/dev/null || true
    chmod 777 "$TRIM_PKGTMP" 2>/dev/null || true
fi

# 确保下载目录存在（@appshare 下自动创建）
if [ -d "$SAVE_PATH" ]; then
    chown -R package:package "$SAVE_PATH" 2>/dev/null || true
elif echo "$SAVE_PATH" | grep -qE '^/vol[0-9]+/@appshare/'; then
    mkdir -p "$SAVE_PATH" 2>/dev/null && chown -R package:package "$SAVE_PATH" 2>/dev/null || echo "警告：无法自动创建下载目录（${SAVE_PATH}），可能因权限不足" > "$TRIM_TEMP_LOGFILE"
fi

# 检查配置文件是否已存在（用户卸载时可能保留了配置）
if [ -f "$CONFIG_DIR" ]; then
    echo "检测到已有配置文件，保留原有设置..."

    # 用 python3 安全更新 JSON（避免 sed 注入特殊字符破坏配置/密码）
    # 密码经环境变量传递，避免出现在命令行/进程列表中
    RPC_PASSWORD_VAL="$RPC_PASSWORD" python3 - "$CONFIG_DIR" "$RPC_USERNAME" "$SAVE_PATH" << 'PYEOF'
import json, os, sys
config_path, username, save_path = sys.argv[1:4]
password = os.environ.get("RPC_PASSWORD_VAL", "")
try:
    with open(config_path, 'r', encoding='utf-8') as f:
        cfg = json.load(f)
except Exception as e:
    sys.stderr.write("无法读取配置文件 %s: %s\n" % (config_path, e))
    sys.exit(1)
# 用户名/密码：向导留空则保留已有
if username:
    cfg["rpc-username"] = username
if password:
    cfg["rpc-password"] = password
if save_path:
    cfg["download-dir"] = save_path
# 网关模式：禁用RPC认证（网关已认证）、绑定127.0.0.1、禁用临时目录
cfg["rpc-authentication-required"] = False
cfg["rpc-bind-address"] = "127.0.0.1"
cfg["incomplete-dir-enabled"] = False
try:
    with open(config_path, 'w', encoding='utf-8') as f:
        json.dump(cfg, f, indent=4, ensure_ascii=False)
except Exception as e:
    sys.stderr.write("无法写入配置文件 %s: %s\n" % (config_path, e))
    sys.exit(1)
PYEOF
    if [ $? -ne 0 ]; then
        echo "错误：更新已有配置文件失败" > "$TRIM_TEMP_LOGFILE"
        exit 1
    fi
    if [ -n "$RPC_USERNAME" ]; then
        echo "已更新用户名: ${RPC_USERNAME}"
    else
        echo "用户名留空，保留已有用户名"
    fi
    if [ -n "$RPC_PASSWORD" ]; then
        echo "已更新密码"
    else
        echo "密码留空，保留已有密码"
    fi
    echo "配置已更新（保留原有其他设置）"
else
    echo "创建新配置文件..."

    # 首次安装：SSO 网关免密模式，未设置时自动生成随机内部凭证（不使用公开默认密码）
    if [ -z "$RPC_USERNAME" ]; then
        RPC_USERNAME="transmission"
    fi
    if [ -z "$RPC_PASSWORD" ]; then
        RPC_PASSWORD=$(head -c 24 /dev/urandom 2>/dev/null | base64 2>/dev/null | tr -dc 'a-zA-Z0-9' | head -c 24)
        if [ -z "$RPC_PASSWORD" ]; then
            RPC_PASSWORD="${TRIM_API_TOKEN:-}${RANDOM}${RANDOM}${RANDOM}"
            RPC_PASSWORD=$(echo "$RPC_PASSWORD" | tr -dc 'a-zA-Z0-9' | head -c 24)
        fi
        echo "已生成随机内部凭证（SSO 网关免密）"
    fi

    # 生成配置文件（使用 cat 配合 EOF 注入变量值）
    cat > "$CONFIG_DIR" << EOF
{
    "download-dir": "${SAVE_PATH}",
    "incomplete-dir-enabled": false,
    "dht-enabled": true,
    "pex-enabled": true,
    "lpd-enabled": true,
    "encryption": 1,
    "peer-limit-global": 200,
    "peer-port": 51413,
    "peer-port-random-on-start": true,
    "rpc-enabled": true,
    "rpc-authentication-required": false,
    "rpc-bind-address": "127.0.0.1",
    "rpc-port": ${WEBUI_PORT},
    "rpc-url": "/transmission/",
    "rpc-host-whitelist-enabled": false,
    "rpc-whitelist-enabled": false,
    "rpc-username": "${RPC_USERNAME}",
    "rpc-password": "${RPC_PASSWORD}",
    "start-added-torrents": true,
    "utp-enabled": true
}
EOF

    echo "新配置文件已创建"
fi

# 确保配置目录权限正确
chown -R package:package "$DATA_DIR" 2>/dev/null || true

# 同步网关免密凭证（重装/覆盖安装后 settings.json 密码可能已是 hash，需确保 .rpc_secret 有对应明文）
"${TRIM_APPDEST}/cmd/main" write_secret 2>/dev/null || true

echo ""
echo "=================================="
echo "Transmission 安装完成"
echo "=================================="
echo ""
echo "网关模式: /app/transmission -> 127.0.0.1:8080 (transmission-manager)"
echo ""
echo "下载目录: ${SAVE_PATH}"
echo "数据目录: $DATA_DIR"
echo "配置文件: $CONFIG_DIR"
echo ""

echo "Transmission 安装成功"
exit 0
