#!/bin/bash
# cmd/upgrade_init - Transmission升级初始化脚本
# 功能：升级前停止服务并备份数据

APP_NAME="transmission-daemon"

# 写入错误日志并退出
ERROR_LOG="${TRIM_TEMP_LOGFILE:-/tmp/${APP_NAME}_error.log}"
error_exit() {
    local message="$1"
    local exit_code="${2:-1}"
    echo "$message" > "$ERROR_LOG"
    exit $exit_code
}
BIN_DIR="${TRIM_APPDEST}/bin"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_DIR="${DATA_DIR}/settings.json"
PID_FILE="${TRIM_PKGTMP}/${APP_NAME}.pid"

# 备份到shares目录（fnOS卸载/升级时保留）
# 解析 TRIM_DATA_SHARE_PATHS 中的多个共享路径，取第一个可用的，避免单一路径解析失败导致备份丢失
SHARE_DIR=""
if [ -n "$TRIM_DATA_SHARE_PATHS" ]; then
    IFS=':' read -ra _share_parts <<< "$TRIM_DATA_SHARE_PATHS"
    for _p in "${_share_parts[@]}"; do
        _p="${_p%/}"
        if [ -n "$_p" ] && [ "$_p" != "/" ] && [ -d "$_p" ]; then
            SHARE_DIR="$_p"
            break
        fi
    done
fi
if [ -z "$SHARE_DIR" ]; then
    SHARE_DIR="/vol1/@appshare/transmission"
fi
BACKUP_DIR="${SHARE_DIR}/.data_backup"
BACKUP_INFO_FILE="${SHARE_DIR}/.backup_info"

# 获取用户选择的数据处理方式
DATA_ACTION="${wizard_data_action:-keep}"
echo "用户选择的数据处理方式: $DATA_ACTION"

echo "=================================="
echo "Transmission 升级开始"
echo "=================================="
echo ""

# 停止服务
echo "[1/3] 停止 ${APP_NAME} 服务..."

STOPPED=false
if [ -x "${TRIM_APPDEST}/cmd/main" ]; then
    "${TRIM_APPDEST}/cmd/main" stop && STOPPED=true || echo "停止命令执行失败或服务已停止"
    rm -f "${TRIM_APPDEST}/transmission.sock" 2>/dev/null || true
elif [ -f "$PID_FILE" ]; then
    PID=$(cat "$PID_FILE")
    if ps -p "$PID" > /dev/null 2>&1; then
        echo "停止进程 (PID: $PID)..."
        kill "$PID" 2>/dev/null || true

        TIMEOUT=30
        while ps -p "$PID" > /dev/null 2>&1 && [ $TIMEOUT -gt 0 ]; do
            sleep 1
            TIMEOUT=$((TIMEOUT - 1))
        done

        if ps -p "$PID" > /dev/null 2>&1; then
            echo "强制终止进程..."
            kill -9 "$PID" 2>/dev/null || true
        fi
        STOPPED=true
    fi
fi

rm -f "$PID_FILE"

if [ "$STOPPED" = true ]; then
    echo "服务已停止"
else
    echo "服务已停止或停止失败，继续升级"
fi

# 处理数据
echo ""
echo "[2/3] 根据用户选择处理数据..."

if [ "$DATA_ACTION" = "delete" ]; then
    echo "用户选择删除所有数据"
    if [ -d "$DATA_DIR" ]; then
        rm -rf "$DATA_DIR"
        echo "数据目录已删除: $DATA_DIR"
    fi
    rm -rf "${SHARE_DIR}/.data_backup"* 2>/dev/null || true
else
    echo "用户选择保留数据，主动备份..."

    # 只要数据目录存在就备份（即使只有空目录也保留目录结构），
    # 避免旧实现用 find 判断"是否有条目"时，因 torrents/resume 为空目录而误判漏备，
    # 导致升级后种子文件丢失。
    if [ -d "$DATA_DIR" ]; then
        # 备份前再次确保 daemon 完全停止，避免运行中写入导致 torrents/resume 备份不完整
        if [ -x "${TRIM_APPDEST}/cmd/main" ]; then
            "${TRIM_APPDEST}/cmd/main" stop >/dev/null 2>&1 || true
        fi
        # 保护：备份目录绝不能位于数据目录内部（防止备份到自身造成数据损坏）
        case "$SHARE_DIR/" in
            "$DATA_DIR/"*)
                SHARE_DIR="/vol1/@appshare/transmission"
                ;;
        esac

        # 备份目录带时间戳：永不覆盖历史备份。
        # 旧实现会先 rm -rf 旧备份再重建，一旦备份中断会导致备份与数据同时丢失。
        STAMP=$(date +%Y%m%d_%H%M%S 2>/dev/null || echo "manual")
        BACKUP_DIR="${SHARE_DIR}/.data_backup_${STAMP}"

        # 创建备份目录
        if ! mkdir -p "$BACKUP_DIR" 2>/dev/null; then
            error_exit "错误：无法创建备份目录，升级失败"
        fi

        # 复制所有数据（含隐藏文件）
        if ! cp -a "$DATA_DIR"/. "$BACKUP_DIR"/ 2>/dev/null; then
            error_exit "错误：备份数据失败，升级终止"
        fi

        # 设置备份目录权限（确保可写）
        chown -R package:package "$BACKUP_DIR" 2>/dev/null || true

        # 验证备份完整性：settings.json 必须备份，torrents/resume 有内容时必须完整
        BACKUP_OK=true
        if [ ! -f "${BACKUP_DIR}/settings.json" ]; then
            BACKUP_OK=false
        fi
        if [ -d "$DATA_DIR/torrents" ] && [ -n "$(ls -A "$DATA_DIR/torrents" 2>/dev/null)" ]; then
            if [ ! -d "${BACKUP_DIR}/torrents" ] || [ -z "$(ls -A "${BACKUP_DIR}/torrents" 2>/dev/null)" ]; then
                BACKUP_OK=false
            fi
        fi
        if [ -d "$DATA_DIR/resume" ] && [ -n "$(ls -A "$DATA_DIR/resume" 2>/dev/null)" ]; then
            if [ ! -d "${BACKUP_DIR}/resume" ] || [ -z "$(ls -A "${BACKUP_DIR}/resume" 2>/dev/null)" ]; then
                BACKUP_OK=false
            fi
        fi
        if [ "$BACKUP_OK" = false ]; then
            # 备份校验失败：不终止升级（避免升级中断卡死），改为警告并保留备份，
            # 升级后仍可手动从备份恢复数据。
            echo "警告：备份验证未完全通过（settings.json/torrents/resume 可能不完整），"
            echo "备份已保留在 $BACKUP_DIR，升级后请检查数据，必要时手动恢复！"
        fi

        echo "数据已成功备份到: $BACKUP_DIR"
        # 尝试写入备份信息文件（可能权限不足，但不影响升级）
        echo "BACKUP_DIR=$BACKUP_DIR" > "$BACKUP_INFO_FILE" 2>/dev/null || echo "警告：无法写入备份信息文件"

        # 仅保留最近 5 份历史备份，避免占用过多空间（刚生成的备份不删除）
        _all=$(ls -1d "${SHARE_DIR}"/.data_backup_* 2>/dev/null | sort)
        _count=$(printf '%s\n' "$_all" | grep -c . 2>/dev/null)
        if [ -n "$_count" ] && [ "$_count" -gt 5 ] 2>/dev/null; then
            printf '%s\n' "$_all" | head -n $((_count - 5)) | while IFS= read -r _old; do
                [ -n "$_old" ] && rm -rf "$_old" 2>/dev/null
            done
        fi
    else
        echo "无现有数据需要备份或数据目录为空"
    fi
fi

echo ""
echo "=================================="
echo "Transmission 升级初始化完成"
echo "=================================="
exit 0
