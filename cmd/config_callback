#!/bin/bash
# cmd/config_callback - Transmission配置回调脚本
# 功能：应用或更新用户配置的用户名密码、下载目录、端口

APP_NAME="transmission-daemon"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_DIR="${DATA_DIR}/settings.json"
PID_FILE="${TRIM_PKGTMP}/${APP_NAME}.pid"

# 获取脚本目录
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

echo "正在应用 Transmission 配置..."

# 检查配置目录
if [ -z "$DATA_DIR" ]; then
    echo "错误：TRIM_PKGVAR 环境变量未设置" > "$TRIM_TEMP_LOGFILE"
    exit 1
fi

# 检查应用是否正在运行
WAS_RUNNING=false
if [ -f "$PID_FILE" ]; then
    PID=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$PID" ] && ps -p "$PID" > /dev/null 2>&1; then
        WAS_RUNNING=true
        echo "应用正在运行，需要先停止..."
        "$SCRIPT_DIR/main" stop
        sleep 2
    else
        echo "应用当前处于停止状态"
    fi
else
    echo "应用当前处于停止状态"
fi

# 创建配置目录
mkdir -p "$DATA_DIR"

# 设置目录权限
chown -R package:package "$DATA_DIR" 2>/dev/null || true

# 获取用户配置（从向导或环境变量）
RPC_USERNAME="${wizard_rpc_username:-${RPC_USERNAME:-transmission}}"
RPC_PASSWORD="${wizard_rpc_password:-}"
SAVE_PATH="${wizard_save_path:-}"
# RPC 对外绑定与认证开关（可选，不传则保留用户已有配置）
RPC_BIND_ADDRESS="${wizard_rpc_bind_address:-}"
RPC_AUTH_REQUIRED="${wizard_rpc_auth:-}"

# 网关模式：端口固定内部值，默认9090；可从配置向导修改
WEBUI_PORT="${wizard_webui_port:-9090}"
# 校验端口为 1-65535 的整数，否则回退到默认值
if ! [[ "$WEBUI_PORT" =~ ^[1-9][0-9]{0,4}$ ]] || [ "$WEBUI_PORT" -lt 1 ] || [ "$WEBUI_PORT" -gt 65535 ]; then
    echo "警告：无效端口 $WEBUI_PORT，使用默认 9090" >&2
    WEBUI_PORT="9090"
fi

# 读取现有配置或创建新配置
if [ -f "$CONFIG_DIR" ]; then
    echo "检测到已有配置文件，保留其他设置并更新用户名、密码、端口、下载目录..."

    # 更新下载目录（如果提供了）前先确保目录存在（@appshare 下自动创建）
    if [ -n "$SAVE_PATH" ]; then
        if [ -d "$SAVE_PATH" ]; then
            chown -R package:package "$SAVE_PATH" 2>/dev/null || true
        elif echo "$SAVE_PATH" | grep -qE '^/vol[0-9]+/@appshare/'; then
            mkdir -p "$SAVE_PATH" 2>/dev/null || true
            chown -R package:package "$SAVE_PATH" 2>/dev/null || true
        fi
    fi

    # 用 python3 安全更新 JSON（避免 sed 注入特殊字符破坏配置/密码）
    # 密码经环境变量传递，避免出现在命令行/进程列表中
    RPC_PASSWORD_VAL="$RPC_PASSWORD" python3 - "$CONFIG_DIR" "$RPC_USERNAME" "$SAVE_PATH" "$WEBUI_PORT" "$RPC_BIND_ADDRESS" "$RPC_AUTH_REQUIRED" << 'PYEOF'
import json, os, sys
config_path, username, save_path, webui_port, bind_address, auth_required = sys.argv[1:7]
password = os.environ.get("RPC_PASSWORD_VAL", "")
try:
    with open(config_path, 'r', encoding='utf-8') as f:
        cfg = json.load(f)
except Exception as e:
    sys.stderr.write("无法读取配置文件 %s: %s\n" % (config_path, e))
    sys.exit(1)
# 用户名：配置向导必填，始终更新
if username:
    cfg["rpc-username"] = username
# 密码：仅当用户提供了新密码时才更新，否则保留现有密码
if password:
    cfg["rpc-password"] = password
# 下载目录：提供了才更新
if save_path:
    cfg["download-dir"] = save_path
# 端口
cfg["rpc-port"] = int(webui_port)
# RPC 对外绑定与认证：仅当向导显式提供时才更新，否则保留用户已有配置
# （网关模式默认 127.0.0.1 + 免密；如需局域网 RPC 直连，可设置 bind=0.0.0.0、auth=1）
if bind_address:
    cfg["rpc-bind-address"] = bind_address
if auth_required in ("1", "true", "True"):
    cfg["rpc-authentication-required"] = True
elif auth_required in ("0", "false", "False"):
    cfg["rpc-authentication-required"] = False
try:
    with open(config_path, 'w', encoding='utf-8') as f:
        json.dump(cfg, f, indent=4, ensure_ascii=False)
except Exception as e:
    sys.stderr.write("无法写入配置文件 %s: %s\n" % (config_path, e))
    sys.exit(1)
PYEOF
    if [ $? -ne 0 ]; then
        echo "错误：更新配置文件失败" > "$TRIM_TEMP_LOGFILE"
        exit 1
    fi

    # 校验结果
    PORT_RESULT=$(python3 -c "import json; print(json.load(open('$CONFIG_DIR')).get('rpc-port','?'))" 2>/dev/null)
    echo "配置端口: ${PORT_RESULT:-$WEBUI_PORT}"
    if [ -n "$RPC_PASSWORD" ]; then
        echo "已更新密码"
    else
        echo "密码留空，保留当前密码"
    fi
    if [ -n "$SAVE_PATH" ]; then
        echo "已更新下载目录: ${SAVE_PATH}"
    fi
    echo "配置更新完成，已保留用户的其他设置"
else
    echo "创建新配置文件..."
    mkdir -p "$(dirname "$CONFIG_DIR")"

    # 首次创建配置：使用默认下载目录
    if [ -z "$SAVE_PATH" ]; then
        SAVE_PATH="/vol1/@appshare/transmission/downloads/"
    fi
    # 默认密码（首次创建时若未设置，自动生成随机内部凭证，不使用公开默认密码）
    if [ -z "$RPC_PASSWORD" ]; then
        RPC_PASSWORD=$(head -c 24 /dev/urandom 2>/dev/null | base64 2>/dev/null | tr -dc 'a-zA-Z0-9' | head -c 24)
        if [ -z "$RPC_PASSWORD" ]; then
            RPC_PASSWORD="${TRIM_API_TOKEN:-}${RANDOM}${RANDOM}${RANDOM}"
            RPC_PASSWORD=$(echo "$RPC_PASSWORD" | tr -dc 'a-zA-Z0-9' | head -c 24)
        fi
    fi
    # 首次创建默认网关模式（127.0.0.1 + 免密）；可通过向导字段 wizard_rpc_bind_address / wizard_rpc_auth 覆盖
    RPC_BIND_ADDRESS="${RPC_BIND_ADDRESS:-127.0.0.1}"
    RPC_AUTH_REQUIRED="${RPC_AUTH_REQUIRED:-0}"
    if [ "$RPC_AUTH_REQUIRED" = "1" ]; then
        RPC_AUTH_BOOL="true"
    else
        RPC_AUTH_BOOL="false"
    fi

    cat > "$CONFIG_DIR" << EOF
{
    "download-dir": "${SAVE_PATH}",
    "incomplete-dir-enabled": false,
    "dht-enabled": true,
    "pex-enabled": true,
    "lpd-enabled": true,
    "encryption": 1,
    "peer-limit-global": 200,
    "peer-port": 51413,
    "peer-port-random-on-start": true,
    "rpc-enabled": true,
    "rpc-authentication-required": ${RPC_AUTH_BOOL},
    "rpc-bind-address": "${RPC_BIND_ADDRESS}",
    "rpc-port": ${WEBUI_PORT},
    "rpc-url": "/transmission/",
    "rpc-host-whitelist-enabled": false,
    "rpc-whitelist-enabled": false,
    "rpc-username": "${RPC_USERNAME}",
    "rpc-password": "${RPC_PASSWORD}",
    "start-added-torrents": true,
    "utp-enabled": true
}
EOF
fi

chown -R package:package "$DATA_DIR" 2>/dev/null || true

# 同步网关免密凭证（用户修改密码后刷新 .rpc_secret，保证代理注入的凭证与 daemon 一致）
"$SCRIPT_DIR/main" write_secret 2>/dev/null || true

echo ""
echo "==================================="
echo "Transmission 配置已应用"
echo "==================================="
echo ""
echo "用户名: ${RPC_USERNAME}"
echo ""
echo "网关模式: /app/transmission -> 127.0.0.1:8080 (trpanel)"
echo "RPC 服务: 127.0.0.1:${WEBUI_PORT}"
echo ""

# 根据之前的状态决定是否启动服务
if [ "$WAS_RUNNING" = true ]; then
    echo "应用之前在运行，正在重启..."
    if ! "$SCRIPT_DIR/main" start; then
        echo "错误：服务启动失败" > "$TRIM_TEMP_LOGFILE"
        exit 1
    fi
    echo "Transmission 配置已应用，服务已重启"
else
    echo "应用之前处于停止状态，配置已应用，不会自动启动"
fi

echo "Transmission 配置应用完成"
exit 0
