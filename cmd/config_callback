#!/bin/bash
# cmd/config_callback - Transmission配置回调脚本
# 功能：应用或更新用户配置的用户名密码

APP_NAME="transmission-daemon"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_DIR="${DATA_DIR}/settings.json"
PID_FILE="${TRIM_PKGTMP}/${APP_NAME}.pid"

# 获取脚本目录
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

echo "正在应用 Transmission 配置..."

# 检查配置目录
if [ -z "$DATA_DIR" ]; then
    echo "错误：TRIM_PKGVAR 环境变量未设置" > "$TRIM_TEMP_LOGFILE"
    exit 1
fi

# 检查应用是否正在运行
WAS_RUNNING=false
if [ -f "$PID_FILE" ]; then
    PID=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$PID" ] && ps -p "$PID" > /dev/null 2>&1; then
        WAS_RUNNING=true
        echo "应用正在运行，需要先停止..."
        "$SCRIPT_DIR/main" stop
        sleep 2
    else
        echo "应用当前处于停止状态"
    fi
else
    echo "应用当前处于停止状态"
fi

# 创建配置目录
mkdir -p "$DATA_DIR"

# 设置目录权限
chown -R package:package "$DATA_DIR" 2>/dev/null || true

# 获取用户配置（从向导或环境变量）
RPC_USERNAME="${wizard_rpc_username:-${RPC_USERNAME:-admin}}"
RPC_PASSWORD="${wizard_rpc_password:-${RPC_PASSWORD:-password}}"

# 网关模式：端口固定内部值，默认9090；可从配置向导修改
WEBUI_PORT="${wizard_webui_port:-9090}"
# 校验端口为 1-65535 的整数，否则回退到默认值
if ! [[ "$WEBUI_PORT" =~ ^[1-9][0-9]{0,4}$ ]] || [ "$WEBUI_PORT" -lt 1 ] || [ "$WEBUI_PORT" -gt 65535 ]; then
    echo "警告：无效端口 $WEBUI_PORT，使用默认 9090" >&2
    WEBUI_PORT="9090"
fi

# 读取现有配置或创建新配置
if [ -f "$CONFIG_DIR" ]; then
    echo "检测到已有配置文件，保留其他设置并更新用户名、密码、端口..."
    
    # 使用 sed 更新 JSON 配置文件中的指定字段，保留其他用户配置
    sed -i "s|\"rpc-username\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"rpc-username\": \"${RPC_USERNAME}\"|g" "$CONFIG_DIR"
    sed -i "s|\"rpc-password\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"rpc-password\": \"${RPC_PASSWORD}\"|g" "$CONFIG_DIR"
    
    # 更新 rpc-port，保留其他设置
    if grep -q '"rpc-port"' "$CONFIG_DIR"; then
        sed -i "s|\"rpc-port\"[[:space:]]*:[[:space:]]*[0-9]*|\"rpc-port\": ${WEBUI_PORT}|g" "$CONFIG_DIR"
    else
        sed -i '/"rpc-bind-address"/a\    "rpc-port": '"${WEBUI_PORT}"',' "$CONFIG_DIR"
    fi
    
    # 校验结果
    PORT_RESULT=$(python3 -c "import json; print(json.load(open('$CONFIG_DIR')).get('rpc-port','?'))" 2>/dev/null)
    echo "配置端口: ${PORT_RESULT:-$WEBUI_PORT}"
    
    # 网关模式：禁用RPC认证、绑定127.0.0.1
    sed -i 's|"rpc-authentication-required"[[:space:]]*:[[:space:]]*[^,]*|"rpc-authentication-required": false|g' "$CONFIG_DIR"
    if ! grep -q '"rpc-bind-address"' "$CONFIG_DIR"; then
        sed -i '/"rpc-port"/a\    "rpc-bind-address": "127.0.0.1",' "$CONFIG_DIR"
    else
        sed -i 's|"rpc-bind-address"[[:space:]]*:[[:space:]]*"[^"]*"|"rpc-bind-address": "127.0.0.1"|g' "$CONFIG_DIR"
    fi
    
    echo "配置更新完成，已保留用户的其他设置"
else
    echo "创建新配置文件..."
    mkdir -p "$(dirname "$CONFIG_DIR")"
    
    cat > "$CONFIG_DIR" << EOF
{
    "download-dir": "/vol1/1000/downloads",
    "incomplete-dir": "/vol1/1000/temp",
    "incomplete-dir-enabled": true,
    "dht-enabled": true,
    "pex-enabled": true,
    "lpd-enabled": true,
    "encryption": 1,
    "peer-limit-global": 200,
    "peer-port": 51413,
    "peer-port-random-on-start": true,
    "rpc-enabled": true,
    "rpc-authentication-required": false,
    "rpc-bind-address": "127.0.0.1",
    "rpc-port": ${WEBUI_PORT},
    "rpc-url": "/transmission/",
    "rpc-host-whitelist-enabled": false,
    "rpc-whitelist-enabled": false,
    "rpc-username": "${RPC_USERNAME}",
    "rpc-password": "${RPC_PASSWORD}",
    "start-added-torrents": true,
    "utp-enabled": true
}
EOF
fi

echo ""
echo "==================================="
echo "Transmission 配置已应用"
echo "==================================="
echo ""
echo "用户名: ${RPC_USERNAME}"
echo ""
echo "网关模式: /app/transmission -> 127.0.0.1:${WEBUI_PORT}"
echo ""

# 根据之前的状态决定是否启动服务
if [ "$WAS_RUNNING" = true ]; then
    echo "应用之前在运行，正在重启..."
    if ! "$SCRIPT_DIR/main" start; then
        echo "错误：服务启动失败" > "$TRIM_TEMP_LOGFILE"
        exit 1
    fi
    echo "Transmission 配置已应用，服务已重启"
else
    echo "应用之前处于停止状态，配置已应用，不会自动启动"
fi

echo "Transmission 配置应用完成"
exit 0
