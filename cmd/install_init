#!/bin/bash
# cmd/install_init - Transmission安装初始化脚本
# 功能：验证安装前的必要条件

echo "Transmission install_init started"

# 获取下载目录配置
SAVE_PATH="${wizard_save_path:-/vol1/@appshare/transmission/downloads/}"

echo "Checking save path: $SAVE_PATH"

# @appshare下子目录不检测存在性，启动时自动创建；其他路径需验证存在
if [[ ! "$SAVE_PATH" =~ @appshare ]]; then
    if [ ! -d "$SAVE_PATH" ]; then
        echo "错误：下载目录（$SAVE_PATH）不存在" > "$TRIM_TEMP_LOGFILE"
        echo "请在 fnOS 文件管理中创建该目录后重试" >> "$TRIM_TEMP_LOGFILE"
        exit 1
    fi
fi

echo "Path validation passed"
echo "Transmission install_init completed"
exit 0
