#!/bin/bash
# cmd/main - Transmission应用生命周期管理脚本

APP_NAME="transmission-daemon"
BIN_DIR="${TRIM_APPDEST}/bin"
LIB_DIR="${TRIM_APPDEST}/lib"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_DIR="${DATA_DIR}/settings.json"
PID_FILE="${TRIM_PKGTMP}/${APP_NAME}.pid"
LOG_FILE="${TRIM_PKGVAR}/${APP_NAME}.log"

# WebUI 由 transmission-manager 提供（Go+React 单二进制，内嵌前端）。
# manager 直接监听 fnOS 统一网关的 Unix socket（无中间代理层）。
MANAGER_BIN="${BIN_DIR}/transmission-manager"
MANAGER_PID_FILE="${TRIM_PKGTMP}/${APP_NAME}-manager.pid"
MANAGER_DATA_DIR="${DATA_DIR}/manager"
GATEWAY_SOCK="${TRIM_APPDEST}/transmission.sock"
GATEWAY_PREFIX="/app/transmission"

# 设置库路径（WebUI 前端已内嵌于 transmission-manager，不再覆盖 daemon 的 web 目录）
export LD_LIBRARY_PATH="${LIB_DIR}:${LD_LIBRARY_PATH}"

# daemon RPC 端口（内部值，不暴露给用户；manager 通过 TR_URL 连接此端口）
WEBUI_PORT="9090"

# 检查环境变量
if [ -z "$TRIM_APPDEST" ]; then
    SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)"
    if [[ "$SCRIPT_PATH" =~ /var/apps/([^/]+)/cmd ]]; then
        export TRIM_APPDEST="/var/apps/${BASH_REMATCH[1]}"
        export TRIM_PKGTMP="/var/tmp/${BASH_REMATCH[1]}"
        export TRIM_PKGVAR="/var/lib/${BASH_REMATCH[1]}"
    fi
fi

# 写入错误日志并退出
ERROR_LOG="${TRIM_TEMP_LOGFILE:-/tmp/${APP_NAME}_error.log}"
error_exit() {
    local message="$1"
    local exit_code="${2:-1}"
    echo "$message" > "$ERROR_LOG"
    exit $exit_code
}

read_transmission_port() {
    if [ -f "$CONFIG_DIR" ]; then
        PORT_FROM_CONFIG=$(python3 -c "import json; c=json.load(open('$CONFIG_DIR')); print(c.get('rpc-port',0))" 2>/dev/null)
        if [ -n "$PORT_FROM_CONFIG" ] && [ "$PORT_FROM_CONFIG" -gt 0 ] 2>/dev/null; then
            WEBUI_PORT="$PORT_FROM_CONFIG"
        fi
    fi
}

write_rpc_secret() {
    # 同步/修复 .rpc_secret，保证网关代理始终能拿到与 daemon 当前密码一致的明文凭证。
    # 三种情形：
    #  1) settings.json 密码是明文          -> 直接同步到 .rpc_secret
    #  2) 密码是 hash 且 .rpc_secret 已有明文 -> 用该明文回写 settings.json（同一密码重新 hash，保持一致）
    #  3) 密码是 hash 且 .rpc_secret 无明文   -> 生成新的随机内部凭证，同时写 settings.json 和 .rpc_secret
    #     （升级/重装后 settings.json 密码已被 daemon 加密写回、且无历史明文时，必须重建凭证否则网关免密失效）
    if [ ! -f "$CONFIG_DIR" ]; then
        return 0
    fi
    SECRET_FILE="${DATA_DIR}/.rpc_secret"
    python3 - "$CONFIG_DIR" "$SECRET_FILE" "$(id -u)" "$(id -g)" << 'PYEOF'
import json, sys, os, secrets
config_path, secret_path, uid, gid = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]

def load_cfg():
    try:
        with open(config_path, 'r', encoding='utf-8') as f:
            return json.load(f)
    except Exception:
        return None

def read_secret():
    try:
        with open(secret_path, 'r') as f:
            line = f.read().strip()
        if ":" in line:
            u, p = line.split(":", 1)
            if u and p:
                return (u, p)
    except Exception:
        pass
    return None

def write_secret(user, pwd):
    try:
        with open(secret_path, 'w') as f:
            f.write("%s:%s" % (user, pwd))
        os.chmod(secret_path, 0o600)
        try:
            os.chown(secret_path, int(uid), int(gid))
        except Exception:
            pass
    except Exception:
        pass

def save_cfg(cfg):
    try:
        with open(config_path, 'w', encoding='utf-8') as f:
            json.dump(cfg, f, indent=4, ensure_ascii=False)
    except Exception:
        pass

cfg = load_cfg()
if not cfg:
    sys.exit(0)

user = (cfg.get("rpc-username") or "").strip() or "transmission"
pwd = cfg.get("rpc-password") or ""

if not pwd:
    # 未设置密码：无需认证，清空 secret
    write_secret(user, "")
    sys.exit(0)

if pwd.startswith("{"):
    # 密码已被 daemon 加密写回（hash 形式，不可逆）
    secret = read_secret()
    if secret:
        # 用 .rpc_secret 中的明文回写 settings.json，确保与 daemon 当前密码一致
        if cfg.get("rpc-password") != secret[1] or cfg.get("rpc-username") != secret[0]:
            cfg["rpc-username"] = secret[0]
            cfg["rpc-password"] = secret[1]
            save_cfg(cfg)
        write_secret(secret[0], secret[1])
    else:
        # 无明文可用：生成新的随机内部凭证
        new_pwd = secrets.token_urlsafe(18)
        cfg["rpc-username"] = user
        cfg["rpc-password"] = new_pwd
        save_cfg(cfg)
        write_secret(user, new_pwd)
else:
    # 明文密码：直接同步
    write_secret(user, pwd)
PYEOF
}

read_rpc_creds() {
    # 从 .rpc_secret 读取 RPC 明文凭证（user:pass），供 transmission-manager 连接 daemon 使用
    RPC_USER="transmission"
    RPC_PASS=""
    local secret_file="${DATA_DIR}/.rpc_secret"
    if [ -f "$secret_file" ]; then
        IFS=':' read -r RPC_USER RPC_PASS < "$secret_file"
        [ -z "$RPC_USER" ] && RPC_USER="transmission"
    fi
}

start_manager() {
    if [ ! -f "$MANAGER_BIN" ]; then
        echo "Warning: transmission-manager not found, WebUI unavailable"
        return 1
    fi
    if [ ! -x "$MANAGER_BIN" ]; then
        chmod +x "$MANAGER_BIN" 2>/dev/null || true
    fi

    if [ -f "$MANAGER_PID_FILE" ]; then
        local MPID=$(cat "$MANAGER_PID_FILE")
        if kill -0 "$MPID" 2>/dev/null; then
            echo "transmission-manager is already running (PID: $MPID)"
            return 0
        fi
        rm -f "$MANAGER_PID_FILE"
    fi

    read_transmission_port
    read_rpc_creds
    mkdir -p "$MANAGER_DATA_DIR"

    # 升级/重装场景：清理旧版本残留的 gateway-proxy 代理进程与 socket，
    # 确保网关入口由 manager 直接接管（否则旧进程会占用 GATEWAY_SOCK）
    pkill -f "gateway-proxy.py.*${GATEWAY_SOCK}" 2>/dev/null || true
    rm -f "$GATEWAY_SOCK"

    # 通过环境变量注入连接配置（优先级最高，覆盖 .env/.env.local/config.yaml）
    # SERVER_SOCKET：直接监听 fnOS 网关 Unix socket；GATEWAY_PREFIX：网关路径前缀
    # TM_PLATFORM：显式指定宿主平台为 fnOS，启用文件选择器/打开目录/更新等专属能力
    TR_URL="http://127.0.0.1:${WEBUI_PORT}/transmission/rpc" \
    TR_USER="${RPC_USER}" \
    TR_PASS="${RPC_PASS}" \
    SERVER_SOCKET="${GATEWAY_SOCK}" \
    GATEWAY_PREFIX="${GATEWAY_PREFIX}" \
    TM_PLATFORM="fnos" \
    TM_DATA_DIR="${MANAGER_DATA_DIR}" \
    GIN_MODE="release" \
    LOG_LEVEL="warn" \
    "$MANAGER_BIN" >> "$LOG_FILE" 2>&1 &
    local MPID=$!
    echo $MPID > "$MANAGER_PID_FILE"

    # 轮询等待进程存活（manager 初始化失败会自行退出）
    for i in $(seq 1 50); do
        if ! kill -0 "$MPID" 2>/dev/null; then
            break
        fi
        sleep 0.2
    done
    if kill -0 "$MPID" 2>/dev/null; then
        echo "transmission-manager started (PID: $MPID) on ${GATEWAY_SOCK}"
        return 0
    fi
    echo "Warning: transmission-manager failed to start, WebUI unavailable"
    rm -f "$MANAGER_PID_FILE"
    return 1
}

stop_manager() {
    if [ -f "$MANAGER_PID_FILE" ]; then
        local MPID=$(cat "$MANAGER_PID_FILE" 2>/dev/null)
        if kill -0 "$MPID" 2>/dev/null; then
            kill "$MPID" 2>/dev/null || true
            for i in $(seq 1 10); do
                if ! kill -0 "$MPID" 2>/dev/null; then
                    break
                fi
                sleep 0.3
            done
            if kill -0 "$MPID" 2>/dev/null; then
                kill -9 "$MPID" 2>/dev/null || true
            fi
        fi
        rm -f "$MANAGER_PID_FILE"
    fi
    # 兜底：清理残留 manager 进程（仅匹配本应用二进制路径）
    pkill -f "${BIN_DIR}/transmission-manager" 2>/dev/null || true
    echo "transmission-manager stopped"
}

start() {
    # 检查是否已运行
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p "$PID" > /dev/null 2>&1; then
            echo "${APP_NAME} 正在运行 (PID: $PID)"
            return 0
        fi
        rm -f "$PID_FILE"
    fi

    # 创建必要目录（权限不足时自动修复或降级）
    PID_DIR="$(dirname "$PID_FILE")"
    if ! mkdir -p "$PID_DIR" 2>/dev/null; then
        if [ -d "$PID_DIR" ]; then
            chmod 777 "$PID_DIR" 2>/dev/null || true
        fi
        if [ ! -w "$PID_DIR" ] 2>/dev/null; then
            echo "警告：$PID_DIR 不可写，降级使用 /tmp/${APP_NAME}" >> "$LOG_FILE"
            PID_DIR="/tmp/${APP_NAME}"
            PID_FILE="${PID_DIR}/${APP_NAME}.pid"
            MANAGER_PID_FILE="${PID_DIR}/${APP_NAME}-manager.pid"
            mkdir -p "$PID_DIR" 2>/dev/null || true
        fi
    fi
    mkdir -p "$DATA_DIR"
    mkdir -p "${DATA_DIR}/torrents"
    mkdir -p "${DATA_DIR}/resume"

    # 检查可执行文件
    if [ ! -x "$BIN_DIR/transmission-daemon" ]; then
        error_exit "错误：transmission-daemon未找到或不可执行"
    fi

    # 只在配置文件不存在时创建
    if [ ! -f "$CONFIG_DIR" ]; then
        echo "创建默认配置..."
        if ! mkdir -p "$(dirname "$CONFIG_DIR")"; then
            error_exit "错误：无法创建配置目录 $(dirname "$CONFIG_DIR")"
        fi

        # 从环境变量读取或使用默认值（SSO 网关免密：自动生成随机内部凭证，不使用公开默认密码）
        RPC_USERNAME="${RPC_USERNAME:-transmission}"
        RPC_PASSWORD="${RPC_PASSWORD:-}"
        if [ -z "$RPC_PASSWORD" ]; then
            RPC_PASSWORD=$(head -c 24 /dev/urandom 2>/dev/null | base64 2>/dev/null | tr -dc 'a-zA-Z0-9' | head -c 24)
            if [ -z "$RPC_PASSWORD" ]; then
                RPC_PASSWORD="${TRIM_API_TOKEN:-}${RANDOM}${RANDOM}${RANDOM}"
                RPC_PASSWORD=$(echo "$RPC_PASSWORD" | tr -dc 'a-zA-Z0-9' | head -c 24)
            fi
        fi
        SAVE_PATH="${wizard_save_path:-/vol1/@appshare/transmission/downloads/}"

        if ! cat > "$CONFIG_DIR" << EOF
{
    "download-dir": "${SAVE_PATH}",
    "incomplete-dir-enabled": false,
    "dht-enabled": true,
    "pex-enabled": true,
    "lpd-enabled": true,
    "encryption": 1,
    "peer-limit-global": 200,
    "peer-port": 51413,
    "peer-port-random-on-start": true,
    "rpc-enabled": true,
    "rpc-authentication-required": false,
    "rpc-bind-address": "127.0.0.1",
    "rpc-port": ${WEBUI_PORT},
    "rpc-url": "/transmission/",
    "rpc-host-whitelist-enabled": false,
    "rpc-whitelist-enabled": false,
    "rpc-username": "${RPC_USERNAME}",
    "rpc-password": "${RPC_PASSWORD}",
    "start-added-torrents": true,
    "utp-enabled": true
}
EOF
        then
            error_exit "错误：无法写入配置文件 $CONFIG_DIR"
        fi

        echo "默认配置已创建于 $CONFIG_DIR"
    fi

    # 检查下载目录权限
    SAVE_PATH=$(grep -o '"download-dir"[[:space:]]*:[[:space:]]*"[^"]*"' "$CONFIG_DIR" 2>/dev/null | sed 's/.*:.*"\(.*\)"/\1/')

    if [ -n "$SAVE_PATH" ]; then
        if [ ! -d "$SAVE_PATH" ]; then
            if echo "$SAVE_PATH" | grep -qE '@appshare'; then
                mkdir -p "$SAVE_PATH" 2>/dev/null && echo "已创建下载目录：$SAVE_PATH" >> "$LOG_FILE" || echo "警告：无法创建下载目录（$SAVE_PATH）" >> "$LOG_FILE"
            else
                error_exit "错误：下载目录（$SAVE_PATH）不存在，请在 fnOS 文件管理中创建该目录后重试"
            fi
        fi
        if [ -d "$SAVE_PATH" ] && { [ ! -r "$SAVE_PATH" ] || [ ! -w "$SAVE_PATH" ]; }; then
            echo "警告：下载目录（$SAVE_PATH）没有读写权限，请前往 NAS【系统设置 - 应用 - Transmission】设置允许访问的文件夹" >> "$LOG_FILE"
        fi
    fi

    # 同步 RPC 明文凭证到 .rpc_secret，供网关代理免密注入（开启认证后网关访问仍免密）
    write_rpc_secret

    # 启动transmission-daemon
    echo "启动 ${APP_NAME}..."
    
    # 确保目录存在
    mkdir -p "$(dirname "$LOG_FILE")"
    mkdir -p "$(dirname "$PID_FILE")"
    
    # 直接运行（以 package 用户身份）
    "${BIN_DIR}/transmission-daemon" \
        --config-dir "${DATA_DIR}" \
        --pid-file "${PID_FILE}" \
        --logfile "${LOG_FILE}" \
        --foreground \
        >> "${LOG_FILE}" 2>&1 &

    # 轮询等待PID文件创建（最大5秒）
    for i in $(seq 1 25); do
        if [ -f "$PID_FILE" ]; then
            PID=$(cat "$PID_FILE")
            if ps -p "$PID" > /dev/null 2>&1; then
                echo "${APP_NAME} 启动成功 (PID: $PID)"
                start_manager
                return 0
            fi
        fi
        sleep 0.2
    done
    error_exit "错误：${APP_NAME} 启动失败"
}

stop() {
    stop_manager

    # 查找进程
    PID=""
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE" 2>/dev/null)
    fi

    if [ -z "$PID" ] || ! ps -p "$PID" > /dev/null 2>&1; then
        PID=$(pgrep -f "transmission-daemon.*--config-dir" 2>/dev/null | head -1)
    fi

    if [ -z "$PID" ]; then
        echo "${APP_NAME} 未运行"
        return 0
    fi

    echo "停止 ${APP_NAME} (PID: $PID)..."
    kill "$PID" 2>/dev/null || true

    # 等待进程结束
    TIMEOUT=30
    while ps -p "$PID" > /dev/null 2>&1 && [ $TIMEOUT -gt 0 ]; do
        sleep 1
        TIMEOUT=$((TIMEOUT - 1))
    done

    if ps -p "$PID" > /dev/null 2>&1; then
        echo "强制终止进程..."
        kill -9 "$PID" 2>/dev/null || true
    fi

    rm -f "$PID_FILE" 2>/dev/null
    # 兼容清理旧版本可能遗留的 pid 文件（不同 TRIM_PKGTMP 布局）
    rm -f "/var/tmp/${APP_NAME}.pid" 2>/dev/null
    rm -f "/var/tmp/${APP_NAME}/${APP_NAME}.pid" 2>/dev/null

    echo "${APP_NAME} 已停止"
    return 0
}

restart() {
    stop
    sleep 2
    start
}

status() {
    RUNNING=false
    PID=""

    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p "$PID" > /dev/null 2>&1; then
            RUNNING=true
        fi
    fi

    if [ "$RUNNING" = false ]; then
        PID=$(pgrep -f "transmission-daemon.*--config-dir" 2>/dev/null | head -1)
        if [ -n "$PID" ]; then
            RUNNING=true
        fi
    fi

    if [ "$RUNNING" = true ]; then
        echo "${APP_NAME} 正在运行 (PID: $PID)"
        if [ -f "$MANAGER_PID_FILE" ]; then
            MPID=$(cat "$MANAGER_PID_FILE")
            if kill -0 "$MPID" 2>/dev/null; then
                echo "transmission-manager 正在运行 (PID: $MPID)"
            fi
        fi
        return 0
    fi

    echo "${APP_NAME} 未运行"
    return 3
}

case "$1" in
    write_secret)
        # 供 install/upgrade/config 回调复用：确保 .rpc_secret 与 daemon 凭证一致
        write_rpc_secret
        exit $?
        ;;
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    *)
        echo "用法: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
