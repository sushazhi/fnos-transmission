appname = transmission
version = 4.1.3.2.32
display_name = Transmission
desc = <b>轻量级BitTorrent下载工具</b>，支持磁力链接、种子文件、DHT/PEX/LSD P2P网络。<br><br>✨ <b>全新现代 Web 界面</b>：基于 Go + React 重构的管理面板，WebSocket 实时推送、移动端优先、PWA 可安装。<br><br>🔐 <b>免密登录：</b>接入fnOS统一网关，登录系统后即可直接打开，无需设置账号密码。<br><br>🌐 <b>访问方式：</b>通过fnOS统一网关（桌面图标）访问，无需配置端口。<br><br>🔧 <b>端口修改：</b>如需自定义本机内部RPC端口，可在<b>应用设置</b>中修改。<br><br>🐛 <b>问题反馈：</b><a href="https://github.com/sushazhi/fnos-transmission/issues" target="_blank">GitHub Issues</a>

# 系统要求
platform = all
os_min_version = 1.1.3105
source = thirdparty

# 开发者信息
maintainer = Transmission
maintainer_url = https://github.com/transmission/transmission
distributor = yukihana
distributor_url = https://github.com/sushazhi/fnos-transmission

# 安装控制
ctl_stop = true

# JS SDK 支持（文件选择器 / 打开文件管理器）
micro_app = true

# 桌面图标配置
desktop_uidir = ui
desktop_applaunchname = transmission.Application

# 更新日志
