[
  {
    "stepTitle": "⚙️ Transmission 设置",
    "items": [
      {
        "type": "tips",
        "helpText": "💡 <b>设置WebUI访问用户名和密码</b>，保存后将重启应用使配置生效"
      },
      {
        "type": "text",
        "field": "wizard_rpc_username",
        "label": "用户名",
        "rules": [
          {
            "required": true,
            "message": "请输入用户名"
          },
          {
            "min": 2,
            "max": 20,
            "message": "用户名长度应在3-20个字符之间"
          },
          {
            "pattern": "^[a-zA-Z0-9_]+$",
            "message": "只能包含字母、数字和下划线"
          }
        ]
      },
      {
        "type": "password",
        "field": "wizard_rpc_password",
        "label": "密码",
        "rules": [
          {
            "required": true,
            "message": "请输入密码"
          },
          {
            "min": 6,
            "message": "密码长度不能少于6位"
          }
        ]
      },
      {
        "type": "text",
        "field": "wizard_webui_port",
        "label": "WebUI/RPC 端口",
        "initValue": "9090",
        "rules": [
          {
            "required": true,
            "message": "请输入端口号"
          },
          {
            "pattern": "^[1-9][0-9]{0,4}$",
            "message": "端口号必须为 1-65535 之间的整数"
          }
        ]
      },
      {
        "type": "tips",
        "helpText": "📍 <b>端口说明：</b>通过 fnOS 统一网关访问时仍使用固定地址 /app/transmission，此端口用于本机内部 RPC 服务与直连访问。修改后保存将重启应用使配置生效"
      }
    ]
  }
]
